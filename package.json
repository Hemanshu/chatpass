  "files": ["bin/", "src/", "public/", "server.js", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": ["secrets", "one-time-secret", "e2e", "encryption", "llm", "ai-agent", "mcp", "yopass"],
  "repository": { "type": "git", "url": "git+https://github.com/Hemanshu/chatpass.git" },
  "homepage": "https://github.com/Hemanshu/chatpass#readme",
