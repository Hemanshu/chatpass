{
  "name": "chatpass",
  "version": "0.2.0",
  "description": "Share secrets with AI agents via one-time, end-to-end encrypted links. Web UI, CLI and MCP server.",
  "type": "module",
  "main": "src/client.js",
  "exports": {
    ".": "./src/client.js",
    "./mcp": "./src/mcp.js",
    "./server": "./src/server.js"
